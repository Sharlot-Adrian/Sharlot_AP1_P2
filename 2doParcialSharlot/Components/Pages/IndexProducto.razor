@page "/Productos/Index"
@using _2doParcialSharlot.Models
@inject VentasService ventasService;

<PageTitle>Productos Index</PageTitle>
<div class="container">
    <h3>Productos Index</h3>
    <div class="card shadow-lg">
        <div class="card-body">

            @*quickgrid*@
            @if(itemsQueryable != null){
               <div class="grid-mt2">
                <QuickGrid Items="itemsQueryable">
                    <PropertyColumn Property="p => p.ProductoId" Sortable="true"></PropertyColumn>
                    <PropertyColumn Property="p => p.Nombre" Sortable="true"></PropertyColumn>
                    <PropertyColumn Property="p => p.Stock" Sortable="true"></PropertyColumn>
                    <PropertyColumn Property="p => p.Precio" Sortable="true"></PropertyColumn>
                </QuickGrid>
                </div>
            }
        </div>
        @*footer*@
        <div class="card-footer justify-content-between align-content-center mt-2">
            <label class="form-label"><strong>Cantidad de Registros: </strong></label>
            <label class="form-label">@(itemsQueryable?.Count() ?? 0)</label>
        </div>
    </div>
</div>

@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public IQueryable<Productos>? itemsQueryable;

    protected override async Task OnInitializedAsync()
    {
        var result = await ventasService.GetListProductos(v => true);
        if (result != null)
        {
            itemsQueryable = result.Value.AsQueryable();
        }
    }
}
