@page "/Ventas/Index"
@using _2doParcialSharlot.Models
@inject VentasService ventasService

<PageTitle> Index de Ventas </PageTitle>
<div class="container">
    <h3>Index de Ventas</h3>
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title"> Index de Ventas</h5>
            <a href="" class="btn btn-primary"><span class="bi bi-plus-square mt-3">Crear</span></a>
        </div>

        <div class="card-body">
            @*Labels*@
            <div class="row">
                @*filtrar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar</strong></label>
                </div>
                @*Valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>Busqueda</strong></label>
                </div>
            </div>
            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value=""selected disables> Elija una opcion</option>
                        <option value="Id">Id</option>
                        <option value="Concepto">Concepto</option>
                    </InputSelect>
                </div>
                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>
            @*quickgrid*@
            @if (itemsQueryable != null)
            {
                <div class="grid-mt2">
                    <QuickGrid Items="itemsQueryable">
                        <PropertyColumn Property="v => v.VentaId" Sortable="true"></PropertyColumn>
                        <PropertyColumn Property="v => v.Fecha" Sortable="true"></PropertyColumn>
                        <PropertyColumn Property="v => v.Observacion" Sortable="true"></PropertyColumn>
                        <PropertyColumn Property="v => v.Concepto" Sortable="true"></PropertyColumn>
                        <PropertyColumn Property="v => v.Total" Sortable="true"></PropertyColumn>

                        <TemplateColumn title="Opciones">
                            <a href="/Ventas/Edit/@context.VentaId" class="btn btn-outline-primary bi bi-square-pencil">Editar</a>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            }
        </div>
        @*footer*@
        <div class="card-footer justify-content-between align-content-center mt-2">
            <label class="form-label"><strong>Cantidad de Registros: </strong></label>
            <label class="form-label">@(itemsQueryable?.Count() ?? 0)</label>
            <label class ="form-label"><strong>Total de todas las ventas: </strong> </label>
            <label class="form-label">@(itemsQueryable?.Sum(v => v.Total) ?? 0)</label>
        </div>
    </div>
</div>
@*eliminar modal*@

@code {
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public IQueryable<Ventas>? itemsQueryable;

    protected override async Task OnInitializedAsync()
    {
        var result = await ventasService.GetList(v => true);
        itemsQueryable = result.Value.AsQueryable();
    }

    public async Task Buscar()
    {
        if (ValorFiltro.Trim() != null && Filtro == "Id")
        {
            if(int.TryParse(ValorFiltro, out int id))
            {
                var lista = await ventasService.GetList(v => v.VentaId == id);
                itemsQueryable = lista.Value.AsQueryable();
            }
        }
        else if (ValorFiltro.Trim() != null && Filtro == "Concepto")
        {
            var conceptos = await ventasService.GetList(v => v.Concepto.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = conceptos.Value.AsQueryable();
        }
    }
}
